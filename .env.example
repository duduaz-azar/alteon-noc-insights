# Copy to .env and adjust for your environment. Never commit .env.

# ClickHouse HTTP endpoint (used by query-svc and analyzer)
CLICKHOUSE_HOST=clickhouse.example.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=alteon

# External NL-to-SQL AI bridge (Flask service, /api/ask)
AI_BRIDGE_URL=http://ai-bridge.example.internal:5050

# Host port that exposes the frontend (Nginx)
FRONTEND_PORT=80

# Optional: GeoLite2 Country database path inside the query-svc container
GEOIP_DB_PATH=/data/geoip/GeoLite2-Country.mmdb
